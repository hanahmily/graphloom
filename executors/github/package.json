{
  "name": "@graphloom/executor-github",
  "version": "0.2.0",
  "description": "Built-in GitHub executors (graphloom.github/*) run through the common executor protocol",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./executors": {
      "types": "./dist/executors.d.ts",
      "import": "./dist/executors.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-github.d.ts",
      "import": "./dist/testing/fake-github.js"
    },
    "./rehearsal/github-standin": {
      "types": "./dist/rehearsal/github-standin.d.ts",
      "import": "./dist/rehearsal/github-standin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@graphloom/sdk": "0.0.0"
  }
}
