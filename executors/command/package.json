{
  "name": "@graphloom/executor-command",
  "version": "0.1.1",
  "description": "Built-in command executor (graphloom.command/run): runs argv commands in the job's workspace and records their outcomes",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./executors": {
      "types": "./dist/executors.d.ts",
      "import": "./dist/executors.js"
    },
    "./rehearsal/command-standin": {
      "types": "./dist/rehearsal/command-standin.d.ts",
      "import": "./dist/rehearsal/command-standin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@graphloom/sdk": "0.0.0"
  },
  "devDependencies": {
    "@graphloom/runner": "0.0.0"
  }
}
