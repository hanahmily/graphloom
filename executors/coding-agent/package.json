{
  "name": "@graphloom/executor-coding-agent",
  "version": "0.1.0",
  "description": "Built-in coding-agent executor (graphloom.coding-agent/run): adapts an agent harness to the executor protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./executors": {
      "types": "./dist/executors.d.ts",
      "import": "./dist/executors.js"
    },
    "./legacy-executors": {
      "types": "./dist/legacy-executors.d.ts",
      "import": "./dist/legacy-executors.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./testing": {
      "types": "./dist/testing/scripted-harness.d.ts",
      "import": "./dist/testing/scripted-harness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@graphloom/sdk": "0.0.0"
  }
}
