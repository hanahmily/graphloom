{
  "name": "@graphloom/executor-coding-agent",
  "version": "0.1.0",
  "description": "Built-in coding-agent executor (graphloom.coding-agent/run): adapts an agent harness to the executor protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./executors": {
      "types": "./dist/executors.d.ts",
      "import": "./dist/executors.js"
    },
    "./legacy-executors": {
      "types": "./dist/legacy-executors.d.ts",
      "import": "./dist/legacy-executors.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "import": "./dist/codex.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./testing": {
      "types": "./dist/testing/scripted-harness.d.ts",
      "import": "./dist/testing/scripted-harness.js"
    },
    "./rehearsal/pi": {
      "types": "./dist/rehearsal/pi.d.ts",
      "import": "./dist/rehearsal/pi.js"
    },
    "./rehearsal/codex-standin": {
      "types": "./dist/rehearsal/codex-standin.d.ts",
      "import": "./dist/rehearsal/codex-standin.js"
    },
    "./rehearsal/claude-standin": {
      "types": "./dist/rehearsal/claude-standin.d.ts",
      "import": "./dist/rehearsal/claude-standin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/patch-standin-shebang.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node scripts/patch-standin-shebang.mjs && vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@graphloom/sdk": "0.0.0",
    "@earendil-works/pi-ai": "0.87.1"
  }
}
