# Local configuration and credentials
.env
.env.*
!.env.example

# Runtime state and generated output
.graphloom/
.local/
artifacts/
coverage/
bin/
dist/
*.tsbuildinfo
*.log

# Node
node_modules/
npm-debug.log*
package-lock.json.bak

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Disposable example repository
/examples/test-repo/

# Run worktrees and state of examples/issue-fix-graphloom-task.yaml (repo: .
# pins the repository's top level, so they live at its root; the examples/
# paths hold runs pinned before that)
/graphloom/
/graphloom-state/
/examples/graphloom/
/examples/graphloom-state/

# Generated plugin build outputs
/examples/plugins/**/*.so
/examples/plugins/**/dist/
/examples/plugins/**/node_modules/
# Generated digest sidecars (checked-in graphloom.manifest.json is the template)
/examples/plugins/**/*.digest.json
/examples/plugins/**/hello.manifest.json

# Release build output (scripts/release.sh build)
/release-out/

# Committed state-format fixtures are complete run snapshots, built bundle and
# artifacts included (packages/controller/src/upgrade.test.ts checks this).
!/packages/controller/test/fixtures/state-formats/**/
!/packages/controller/test/fixtures/state-formats/**
