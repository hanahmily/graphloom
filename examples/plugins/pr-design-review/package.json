{
  "name": "@graphloom/plugin-pr-design-review",
  "version": "0.1.4",
  "private": true,
  "description": "pr-design-review graph plugin: round 1 of a pull-request review as its own graph. A neutral, cited change report, the necessity question N1 and design-level questions with grounded answers (Fetch, Report, Questions, Answers), the round-1 gate, and one posted review of the open items, or nothing when the design review is clean (Publish)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "test",
    "tools",
    "vendor",
    "scripts",
    "profiles",
    "graphloom.manifest.json",
    "package-lock.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "manifest": "node ./scripts/generate-manifest.mjs",
    "vendor": "node ../review-kit/vendor.mjs"
  },
  "dependencies": {
    "@graphloom/sdk": "file:../../../packages/sdk",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "graphloom": {
    "graphId": "pr-design-review",
    "repairContract": "source-repairable",
    "entry": "./dist/index.js",
    "taskConfig": "required"
  }
}
