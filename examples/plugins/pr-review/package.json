{
  "name": "@graphloom/plugin-pr-review",
  "version": "1.1.0",
  "private": true,
  "description": "pr-review graph plugin, round 2 of a pull request's review: the design review's report or a report-only prelude as context (Fetch, Report), three aspect reviewers with verified findings and deterministic leads (Review), the draft (Draft) and one posted review that counts round 1's open items (Publish)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/kit/metrics/index.d.ts",
      "import": "./dist/kit/metrics/index.js",
      "default": "./dist/kit/metrics/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "test",
    "tools",
    "vendor",
    "scripts",
    "profiles",
    "graphloom.manifest.json",
    "package-lock.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "manifest": "node ./scripts/generate-manifest.mjs",
    "vendor": "node ../review-kit/vendor.mjs"
  },
  "dependencies": {
    "@graphloom/sdk": "file:../../../packages/sdk",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "graphloom": {
    "graphId": "pr-review",
    "repairContract": "source-repairable",
    "entry": "./dist/index.js",
    "taskConfig": "required"
  }
}
