{
  "name": "@graphloom/plugin-pr-review",
  "version": "0.22.0",
  "private": true,
  "description": "pr-review graph plugin: a neutral, cited change report on an incoming pull request, with grounded questions and answers (Fetch, Report, Questions, Answers), a round-1 gate, the aspect review (Review, Draft) and one posted review (Publish)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "default": "./dist/metrics/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "test",
    "tools",
    "vendor",
    "scripts",
    "profiles",
    "graphloom.manifest.json",
    "package-lock.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "manifest": "node ./scripts/generate-manifest.mjs"
  },
  "dependencies": {
    "@graphloom/sdk": "file:../../../packages/sdk",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=22"
  },
  "graphloom": {
    "graphId": "pr-review",
    "repairContract": "source-repairable",
    "entry": "./dist/index.js",
    "taskConfig": "required"
  }
}
