{
  "name": "@graphloom/plugin-pr-review",
  "version": "0.0.0",
  "private": true,
  "description": "pr-review graph plugin: P1 static metrics tools and shared record library (graph code to follow)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "default": "./dist/metrics/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "test",
    "tools",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=22"
  }
}
