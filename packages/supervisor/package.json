    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@graphloom/agent-harness": "0.2.0",
    "@graphloom/sdk": "0.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
