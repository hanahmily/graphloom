{
  "name": "@graphloom/supervisor",
  "version": "0.2.0",
  "description": "Run-wide supervisor session and recovery protocol",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
