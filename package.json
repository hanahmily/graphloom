{
  "name": "graphloom",
  "private": true,
  "version": "0.0.0",
  "description": "Graph-native harness for multi-agent execution",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @graphloom/sdk && npm run test --workspaces --if-present",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
