    "@graphloom/plugin-host": "0.0.0",
    "@graphloom/runner": "0.0.0",
    "@graphloom/sdk": "0.0.0",
    "@graphloom/supervisor": "0.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "devDependencies": {
    "@graphloom/testkit": "0.0.0"
  }
